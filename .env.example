# Optional shell environment settings. Do not commit real secrets -- this file must only ever
# contain empty placeholders/example shapes, never a working credential. Every variable below is
# actually read somewhere in backend/app -- grep for its name if you want to see the call site.

# --- Application -------------------------------------------------------------------------------
# AUTH_MODE=demo (default): every request is the same fixed demo identity -- no setup needed.
# AUTH_MODE=oidc (production): verifies real bearer JWTs against OIDC_ISSUER's JWKS -- see below.
AUTH_MODE=demo
# EMR_MODE=demo (default): reads backend/data/patients.json, writes are local/in-memory only.
# EMR_MODE=fhir: reads from a real FHIR server (FHIR_BASE_URL) -- see the FHIR section below.
EMR_MODE=demo
# SYNEX_DEMO_USER_ID / SYNEX_DEMO_ROLE: only used in AUTH_MODE=demo. Dev-only, not a secret.
# SYNEX_DEMO_USER_ID=demo-dr
# SYNEX_DEMO_ROLE=clinician
# SYNEX_PROVIDER: ONNX Runtime execution provider for the risk model. cpu (default, always works)
# or a CUDA/TensorRT provider name on a GPU/Jetson box -- see docs/JETSON_DEPLOYMENT.md.
SYNEX_PROVIDER=cpu
# SYNEX_PUBLIC_BASE_URL: this server's own externally-reachable base URL, used to build absolute
# links inside CDS Hooks cards. Leave unset for local dev (cards use relative links).
# SYNEX_PUBLIC_BASE_URL=https://synex.example

# --- CORS ----------------------------------------------------------------------------------------
# Comma-separated allowed browser origins for the frontend dev server / deployed SPA.
SYNEX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Must stay 'true' whenever SYNEX_CORS_ORIGINS is not '*' (needed for the synex_session/
# synex_auth_session HttpOnly cookies) -- the app refuses to start if you combine '*' with 'true'.
SYNEX_CORS_ALLOW_CREDENTIALS=true

# --- OIDC (AUTH_MODE=oidc) -----------------------------------------------------------------------
# A real hospital IdP's issuer URL and this app's registered audience/client identifier. Secrets:
# neither of these is itself a secret (they're public OIDC metadata), but only ever point them at
# a real IdP once you've verified it against test_auth.py's JWT-verification assumptions.
# OIDC_ISSUER=https://idp.your-hospital.example
# OIDC_AUDIENCE=synexagent

# --- FHIR (EMR_MODE=fhir) -------------------------------------------------------------------------
# FHIR_BASE_URL: required in EMR_MODE=fhir. Not a secret.
# FHIR_BASE_URL=https://fhir.your-hospital.example/r4
# FHIR_AUTH_MODE picks how FHIRAdapter authenticates each outbound FHIR request -- mutually
# exclusive, never blended (see build_adapter() in backend/app/main.py):
#   client_credentials (default): one shared app-level token via FHIR_CLIENT_ID/SECRET/SCOPE below.
#   smart: per-clinician token from a completed SMART App Launch (see the SMART section below) --
#     fail-closed if no valid session/token/issuer match exists.
# FHIR_AUTH_MODE=client_credentials
# FHIR_CLIENT_ID / FHIR_CLIENT_SECRET: this app's registered FHIR backend-service client.
# SECRET: FHIR_CLIENT_SECRET is a real credential -- never populate it in this checked-in file;
# only ever set it via a real deployment's secret manager / process environment.
# FHIR_CLIENT_ID=
# FHIR_CLIENT_SECRET=
# FHIR_SCOPE=system/*.read
# FHIR_TOKEN_URL: optional override for the client_credentials token endpoint. If unset, the app
# tries .well-known/smart-configuration first and falls back to a guessed conventional path --
# set this explicitly in production rather than relying on that guess.
# FHIR_TOKEN_URL=
# FHIR_REDIRECT_URI: this app's registered SMART App Launch callback URL (used by both
# FHIR_AUTH_MODE=smart and the /smart/launch endpoint below). Not a secret.
# FHIR_REDIRECT_URI=https://synex.example/smart/callback

# --- SMART on FHIR App Launch (/smart/launch, /smart/callback) -----------------------------------
# SYNEX_SMART_TRUSTED_ISSUERS: comma-separated allowlist of `iss` values /smart/launch may perform
# SMART discovery against -- the core SSRF defense (an unset allowlist is permissive/demo-mode;
# every other validation -- https-only, no embedded credentials, private/internal IP rejection --
# still always applies). Set this in any production deployment.
# SYNEX_SMART_TRUSTED_ISSUERS=https://ehr.example/fhir,https://sandbox.example/fhir
# SYNEX_SMART_ALLOW_INSECURE_LOCALHOST: local-dev-only escape hatch that allows a plain-http
# localhost/127.0.0.1 issuer (e.g. a fake local IdP under test). NEVER set true in production.
SYNEX_SMART_ALLOW_INSECURE_LOCALHOST=false
# SYNEX_SMART_TRUSTED_ISSUER (singular -- a DIFFERENT, narrower check than the plural allowlist
# above): in FHIR_AUTH_MODE=smart, the one issuer a stored SMART session's token is trusted to be
# forwarded to when this app calls FHIR_BASE_URL. Defaults to FHIR_BASE_URL itself if unset.
# SYNEX_SMART_TRUSTED_ISSUER=
# SMART_LAUNCH_STATE_TTL_SECONDS: how long an in-flight launch's PKCE state is valid before a
# /smart/callback using it is rejected (checked on every lookup, not just opportunistically).
SMART_LAUNCH_STATE_TTL_SECONDS=600
# SYNEX_COOKIE_SECURE: set false ONLY for local plain-http dev -- production must keep this true so
# the synex_session/synex_auth_session cookies are never sent over an unencrypted connection.
SYNEX_COOKIE_SECURE=true

# --- CDS Hooks (GET /cds-services stays public; POST /cds-services/{service} is gated by this) ---
# CDS_AUTH_MODE=none (default -- matches most CDS Hooks reference implementations, fine for
# demo/interoperability testing). CDS_AUTH_MODE=bearer (production-recommended): requires an
# Authorization: Bearer token verified via the same OIDC_ISSUER/OIDC_AUDIENCE JWKS check as
# AUTH_MODE=oidc, plus a cds:invoke permission -- independent of the app-wide AUTH_MODE.
CDS_AUTH_MODE=none

# --- Storage / multi-worker sharing ---------------------------------------------------------------
# SYNEX_REDIS_URL: if set, every stateful store below (idempotency, SMART launch/session, OIDC auth
# session) switches from a local SQLite file to Redis, so multiple Uvicorn/Gunicorn worker
# processes (or replicas) share the same state. Unset (default) is fine for a single-instance demo.
# SYNEX_REDIS_URL=redis://localhost:6379/0
# Runtime SQLite file paths -- all auto-create on first use and are gitignored; override only if
# you need them somewhere other than backend/data/ (e.g. a persistent volume in a container).
# SYNEX_AUDIT_PATH=/absolute/path/audit.sqlite3
# SYNEX_IDEMPOTENCY_PATH=/absolute/path/idempotency.sqlite3
# SYNEX_SMART_LAUNCH_PATH=/absolute/path/smart_launch.sqlite3
# SYNEX_SESSION_PATH=/absolute/path/smart_session.sqlite3
# SYNEX_AUTH_SESSION_PATH=/absolute/path/auth_session.sqlite3

# --- Frontend ---------------------------------------------------------------------------------
# Frontend dev defaults to /api proxy, production defaults to the same origin.
# VITE_API_BASE=https://your-python-server.example
