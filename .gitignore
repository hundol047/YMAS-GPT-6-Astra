__pycache__/
.pytest_cache/
*.pyc
node_modules/
# frontend/dist is tracked (see below) so `python -m uvicorn ...` alone serves the app with no
# npm/node build step, but Vite's copy of the (already-tracked, large) public/models assets into
# dist/models on every build would duplicate them in git -- excluded, main.py serves /models
# straight from frontend/public/models instead.
frontend/dist/models/
.env
.env.local
.env.test.local
*.sqlite3*
*.engine
*.log
.sites-runtime/

# Root-level intermediate copies from build_real_anatomy.py (the served copies under
# frontend/public/models/anatomy/*.glb are tracked -- see that folder's README.md for how
# to regenerate them).
/anatomy.glb
/extras.glb
bp3d_repo
