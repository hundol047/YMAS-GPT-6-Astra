# Jetson AGX Orin GPU deployment image -- kept SEPARATE from docker/Dockerfile (the plain CPU
# image) rather than parameterizing one Dockerfile for both, since the base image, the ONNX
# Runtime install step, and the GPU runtime requirement are genuinely different concerns.
#
# UNEXERCISED from this development environment: there is no ARM64/Jetson builder available here
# to build or run this image, and no verified base-image tag is hardcoded below (see the BASE_IMAGE
# build-arg) -- filling that in with a guessed tag would violate this project's "never guess a
# JetPack-matched image" rule. Do not treat this file's presence as proof it builds or runs; it is
# reviewed/authored code only, not a validated build.
#
# Usage (on a real Jetson AGX Orin, after you've picked a real, existing base image tag for your
# detected JetPack -- see docs/JETSON_DEPLOYMENT.md):
#   docker build -f docker/Dockerfile.jetson \
#     --build-arg BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:<tag-you-verified-exists-for-your-JetPack> \
#     -t synexagent:jetson-gpu .
#   docker run --runtime nvidia --rm -p 8000:8000 -e SYNEX_PROVIDER=tensorrt synexagent:jetson-gpu
#
# Success is judged the same way as the native path: after starting the container, run
#   docker exec <container> python3 -c "import onnxruntime as ort; print(ort.get_available_providers())"
# and confirm CUDAExecutionProvider (and TensorrtExecutionProvider if applicable) actually appear,
# and that scripts/verify_jetson_agx_gpu.py run inside the container reports a real verified
# session -- the image existing and starting is NOT sufficient evidence of GPU acceleration.

ARG BASE_IMAGE=REPLACE_ME_WITH_A_REAL_VERIFIED_JETPACK_MATCHED_BASE_IMAGE_TAG

FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM ${BASE_IMAGE} AS runtime
WORKDIR /app

# Core dependencies first (no ONNX Runtime) -- matches the native deploy_jetson_agx.sh ordering:
# hardware/JetPack detection informs the ONNX Runtime choice, so it is never installed blind.
COPY backend/requirements-core.txt /app/backend/requirements-core.txt
RUN pip3 install --no-cache-dir -r /app/backend/requirements-core.txt

# The actual GPU ONNX Runtime install is intentionally NOT hardcoded here -- run
# scripts/detect_jetson_env.py and scripts/install_jetson_ort.py (both copied in below) at
# container BUILD time against a real, matching config/jetson_ort_candidates.json entry. If none
# is configured for this exact image's JetPack/CUDA/Python, the build falls back to plain CPU
# onnxruntime rather than guessing.
COPY scripts/ /app/scripts/
COPY config/ /app/config/
COPY backend/requirements.txt /app/backend/requirements.txt
RUN python3 /app/scripts/install_jetson_ort.py --python "$(command -v python3)" || \
    pip3 install --no-cache-dir "$(grep '^onnxruntime==' /app/backend/requirements.txt)"

COPY backend/ /app/backend/
COPY --from=frontend /build/dist /app/frontend/dist
RUN useradd --create-home --uid 10001 synex && mkdir -p /app/runtime && chown -R synex:synex /app/runtime
USER synex
ENV SYNEX_AUDIT_PATH=/app/runtime/audit.sqlite3
ENV SYNEX_IDEMPOTENCY_PATH=/app/runtime/idempotency.sqlite3
ENV SYNEX_PROVIDER=tensorrt
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
CMD ["python3", "-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8000"]
